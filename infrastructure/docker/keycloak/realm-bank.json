{
  "realm": "bank",
  "displayName": "Bank Clients Management",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      { "name": "ADVISOR", "description": "Bank advisor: manages customers, accounts and documents" },
      { "name": "COMPLIANCE_OFFICER", "description": "Compliance officer: reviews KYC cases" },
      { "name": "ADMIN", "description": "Administrator: blocks and closes customers and accounts" }
    ]
  },
  "clients": [
    {
      "clientId": "bank-cli",
      "name": "Developer tools (Bruno, curl)",
      "description": "Local development only: password grant to get a token from the command line",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "bank-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "bank-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "bank-frontend",
      "name": "Web frontend",
      "description": "Single-page application: authorization code flow with PKCE",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [ "http://localhost:4200/*", "http://localhost:5173/*" ],
      "webOrigins": [ "+" ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "bank-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "bank-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "advisor",
      "enabled": true,
      "firstName": "Alice",
      "lastName": "Advisor",
      "email": "advisor@bank.local",
      "emailVerified": true,
      "credentials": [ { "type": "password", "value": "advisor", "temporary": false } ],
      "realmRoles": [ "ADVISOR" ]
    },
    {
      "username": "compliance",
      "enabled": true,
      "firstName": "Chris",
      "lastName": "Compliance",
      "email": "compliance@bank.local",
      "emailVerified": true,
      "credentials": [ { "type": "password", "value": "compliance", "temporary": false } ],
      "realmRoles": [ "COMPLIANCE_OFFICER" ]
    },
    {
      "username": "admin",
      "enabled": true,
      "firstName": "Ada",
      "lastName": "Admin",
      "email": "admin@bank.local",
      "emailVerified": true,
      "credentials": [ { "type": "password", "value": "admin", "temporary": false } ],
      "realmRoles": [ "ADMIN", "ADVISOR", "COMPLIANCE_OFFICER" ]
    }
  ]
}
