{
  "openapi": "3.1.0",
  "info": { "title": "Customer KYC API", "version": "v1" },
  "servers": [{ "url": "http://localhost:8081", "description": "Generated server url" }],
  "security": [{ "bearerAuth": [] }],
  "tags": [{ "name": "KycCases", "description": "KYC case management APIs" }],
  "paths": {
    "/api/v1/kyc-cases": {
      "post": {
        "tags": ["KycCases"],
        "operationId": "createKycCase",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateKycCaseRequest" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/KycCaseResponse" } }
            }
          }
        }
      }
    },
    "/api/v1/kyc-cases/{id}/status": {
      "patch": {
        "tags": ["KycCases"],
        "operationId": "updateKycStatus",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "status",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "NOT_STARTED",
                "IN_PROGRESS",
                "PENDING_REVIEW",
                "APPROVED",
                "REJECTED",
                "EXPIRED"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/KycCaseResponse" } }
            }
          }
        }
      }
    },
    "/api/v1/kyc-cases/{id}": {
      "get": {
        "tags": ["KycCases"],
        "operationId": "getKycCaseById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/KycCaseResponse" } }
            }
          }
        }
      }
    },
    "/api/v1/kyc-cases/customer/{customerId}": {
      "get": {
        "tags": ["KycCases"],
        "operationId": "getKycCaseByCustomerId",
        "parameters": [
          {
            "name": "customerId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/KycCaseResponse" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateKycCaseRequest": {
        "type": "object",
        "properties": {
          "customerId": { "type": "string", "format": "uuid" },
          "riskLevel": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
          "riskScore": { "type": "integer", "format": "int32", "maximum": 100, "minimum": 0 }
        },
        "required": ["customerId", "riskLevel"]
      },
      "KycCaseResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "customerId": { "type": "string", "format": "uuid" },
          "status": {
            "type": "string",
            "enum": [
              "NOT_STARTED",
              "IN_PROGRESS",
              "PENDING_REVIEW",
              "APPROVED",
              "REJECTED",
              "EXPIRED"
            ]
          },
          "riskLevel": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
          "riskScore": { "type": "integer", "format": "int32" },
          "createdAt": { "type": "string", "format": "date-time" },
          "createdBy": { "type": "string" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "updatedBy": { "type": "string" }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "description": "Keycloak access token. Get one with: ./scripts/get-token.sh advisor",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
