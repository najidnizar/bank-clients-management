{
  "openapi": "3.1.0",
  "info": { "title": "Customer Document API", "version": "v1" },
  "servers": [{ "url": "http://localhost:8082", "description": "Generated server url" }],
  "security": [{ "bearerAuth": [] }],
  "tags": [{ "name": "Documents", "description": "Customer document management APIs" }],
  "paths": {
    "/api/v1/documents": {
      "get": {
        "tags": ["Documents"],
        "operationId": "getDocumentsByCustomerId",
        "parameters": [
          {
            "name": "customerId",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/DocumentResponse" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Documents"],
        "operationId": "uploadDocument",
        "parameters": [
          {
            "name": "customerId",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "documentType",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["PASSPORT", "ID_CARD", "PROOF_OF_ADDRESS", "BANK_STATEMENT"]
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": { "file": { "type": "string", "format": "binary" } },
                "required": ["file"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/DocumentResponse" } }
            }
          }
        }
      }
    },
    "/api/v1/documents/{id}": {
      "get": {
        "tags": ["Documents"],
        "operationId": "getDocumentById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/DocumentResponse" } }
            }
          }
        }
      }
    },
    "/api/v1/documents/{id}/content": {
      "get": {
        "tags": ["Documents"],
        "operationId": "downloadDocument",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/octet-stream": { "schema": { "type": "string", "format": "binary" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DocumentResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "customerId": { "type": "string", "format": "uuid" },
          "documentType": {
            "type": "string",
            "enum": ["PASSPORT", "ID_CARD", "PROOF_OF_ADDRESS", "BANK_STATEMENT"]
          },
          "fileName": { "type": "string" },
          "contentType": { "type": "string" },
          "fileSize": { "type": "integer", "format": "int64" },
          "status": { "type": "string", "enum": ["UPLOADED", "VALIDATED", "REJECTED", "EXPIRED"] },
          "createdAt": { "type": "string", "format": "date-time" },
          "createdBy": { "type": "string" }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "description": "Keycloak access token. Get one with: ./scripts/get-token.sh advisor",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
